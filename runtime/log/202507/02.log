[2025-07-02T13:55:30+08:00][sql] 
    CREATE TABLE IF NOT EXISTS colon_cancer_screening (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER NOT NULL DEFAULT 1,
        name VARCHAR(100) NOT NULL,
        contact VARCHAR(200) NOT NULL,
        age VARCHAR(50) NOT NULL,
        gender VARCHAR(10) NOT NULL,
        smoking VARCHAR(10) NOT NULL,
        height DECIMAL(5,2) NOT NULL,
        weight DECIMAL(5,2) NOT NULL,
        bmi DECIMAL(5,2) NOT NULL,
        bmi_category VARCHAR(20) NOT NULL,
        first_degree_rel VARCHAR(10) NOT NULL,
        colorectal_cancer VARCHAR(100) NOT NULL,
        genetic_disease VARCHAR(10) NOT NULL,
        risk_score INTEGER NOT NULL DEFAULT 0,
        risk_level VARCHAR(20) NOT NULL DEFAULT '',
        ai_analysis TEXT,
